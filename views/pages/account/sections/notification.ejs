<!-- #home-tab-pane ... -->
<div class="container my-3">
  <div class="card shadow">
    <div class="card-header text-white">
      <h3 class="mb-0">Home</h3>
    </div>
    <div class="card-body">
      <div class="row g-4">

        <!-- Notifications -->
        <div class="col-lg-12">
          <div class="card shadow-sm h-100">
            <div class="card-header d-flex align-items-start justify-content-between overflow-auto">
              <h5 class="mb-0">Notifications</h5>
              <div id="notification-count" class="badge text-bg-secondary">0</div>
            </div>
            <div class="card-body">
              <div id="notification-list" class="row g-3 overflow-auto">
                <!-- Filled by renderCards(cards) -->
              </div>
              <!-- Empty state -->
              <div id="notification-empty" class="text-muted text-center py-4 d-none">
                No notifications available.
              </div>
            </div>
          </div>
        </div>
      </div> <!-- /row -->
    </div>
  </div>
</div>

<script type="module">
    import { api } from "https://cdn.runeravendynamics.com/clientapi/latest/api.bundle.js";

    await api.initialize();

    function renderNotifications(notifications, modal) {
        const container = document.getElementById('notification-list');
        const empty     = document.getElementById('notification-empty');
        const count     = document.getElementById('notification-count');

        let list = null;
        if (Array.isArray(notifications)) {
            list = notifications;
        } else if (typeof notifications === 'object' && notifications !== null) {
            list = Object.values(notifications);
        } else {
            list = [];
        }

        if (notifications) count.textContent = String(list.length);

        // Reset container
        if (container) container.innerHTML = '';

        // Empty state
        if (!list.length) {
            empty?.classList.remove('d-none');
            return;
        }
        empty?.classList.add('d-none');

        const frag = document.createDocumentFragment();

        list.forEach((n) => {
            // Coerce BigInt/number to normal numbers/strings for display
            const title = n.info.name;
            const message = n.info.notification_settings.message;
            const dateCreated = n.info.date_created;

            const col = document.createElement('div');
            col.className = 'col-md-12';

            col.innerHTML = `
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-body">
                    <div class="d-flex">
                        <div class="me-3 fs-4" aria-hidden="true">🔔</div>
                        <div class="flex-grow-1">
                        <div class="d-flex justify-content-between align-items-start">
                            <div>
                            <strong class="d-block">${String(title ?? '')}</strong>
                            <div class="text-muted small mt-1">${String(message ?? '')}</div>
                            </div>
                            <div class="text-muted small ms-3 text-end">
                            ${dateCreated ? new Date(String(dateCreated)).toLocaleString() : ''}
                            </div>
                        </div>
                        </div>
                    </div>
                    </div>

                    <div class="card-footer bg-transparent d-flex gap-2 justify-content-end">
                    <button class="btn btn-sm btn-outline-primary view-notif-btn" data-id="${n.info?.id ?? ''}">
                        View
                    </button>
                    <button class="btn btn-sm btn-outline-danger delete-notif-btn" data-id="${n.info?.id ?? ''}">
                        Delete
                    </button>
                    </div>
                </div>
            `;

            let viewBtn = col.querySelector(".view-notif-btn");
            let deleteBtn = col.querySelector(".delete-notif-btn");

            viewBtn.addEventListener("click", function() {
              api.tools.BM.updateModal(modal.id, {
                title: n.info.name,
                content: `
                  <div>
                    <div class="d-flex justify-content-between align-items-start mb-2">
                      <div class="fw-semibold">${String(n.info?.name ?? '')}</div>
                      <div class="text-muted small">${n.info?.date_created ? new Date(String(n.info.date_created)).toLocaleString() : ''}</div>
                    </div>

                    <div class="mb-3">
                      <!-- escape HTML and preserve newlines -->
                      ${String(n.info?.message ?? '')
                        .replace(/&/g, '&amp;')
                        .replace(/</g, '&lt;')
                        .replace(/>/g, '&gt;')
                        .replace(/\r\n|\r|\n/g, '<br />')}
                    </div>

                    <!-- optional details / payload -->
                    ${n.info?.data?.details ? `<div class="mb-2"><small class="text-muted">Details:</small>
                      <pre class="bg-light p-2 small" style="max-height:220px;overflow:auto;">${JSON.stringify(n.info.data, null, 2)}</pre>
                    </div>` : ''}

                  </div>
                `,
                buttons: `
                  <button class="btn btn-sm btn-outline-danger delete-notif-btn" data-id="${n.info?.id ?? ''}">
                      Delete
                  </button>
                `
              });
              api.tools.BM.toggleModal(modal.id);
              let modalDeteleBtn = modal.querySelector(".delete-notif-btn");
              modalDeteleBtn.addEventListener("click", async function() {
                api.tools.LM.load(true);
                let result = await api.graph.delete(n.info.id, n.info.type);
                console.log("Notification Deleted: ", result);
                col.remove();
                api.tools.BM.toggleModal(modal.id);
                api.tools.LM.load(false);
              })
            })

            deleteBtn.addEventListener("click", async function() {
              api.tools.LM.load(true);
              let result = await api.graph.delete(n.info.id, n.info.type);
              console.log("Notification Deleted: ", result);
              col.remove();
              api.tools.LM.load(false);
            })

            frag.appendChild(col);
        });

        container?.appendChild(frag);
    }

    const notificationsList = document.getElementById('notification-list');
    const notificationsEmpty = document.getElementById('notification-empty');
    const notificationsCount = document.getElementById('notification-count');

    let notifications = await api.graph.getNodes(api.tools.A.info.user, "children", {type: "notification"});
    notifications = notifications?.objects || notifications || [];

    console.log("Returned Notifications: ", notifications);

    let notificationModal = api.tools.BM.createModal({
      id: "notificationModal",
      title: "View Notification",
      content: ``
    });

    renderNotifications(notifications, notificationModal);
</script>
