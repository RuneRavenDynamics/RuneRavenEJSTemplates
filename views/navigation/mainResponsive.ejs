








<% 
    let navigation = page.info.page_settings.content.navigation || page.module.info.module_settings.content.navigation;
    let pageURL = data.url;
%>

<ul class="navbar-nav nav-pills nav-fill flex-grow-1 align-items-center justify-content-end mb-2 mb-lg-0" id="navigation-main">
    <% if (navigation && navigation.links) { %>
      <% navigation.links.forEach(link => { %>
        <li class="nav-item">
          <% if (link?.type === 'element_id') { %>
              <a
                href="#<%= link.element_id %>"
                class="nav-link scroll-link fs-6 p-2"
              >
            <% } else { %>
              <a
                href="<%= link.url %>"
                class="nav-link fs-6 p-2 <%= link.url === data.url ? 'active' : '' %>"
              >
            <% } %>
            <% if (link.icon) { %>
              <i class="<%= link.icon %> me-1"></i>
            <% } %>
            <%= link.text %>
          </a>
        </li>
      <% }) %>
    <% } %>

    <!-- Accounts dropdown, if needed -->
    <% if (page.info.page_options.accounts) { %>
      <%- include('./accounts.ejs') %>
    <% } %>

    <% if (Array.isArray(navigation?.buttons)) { %>
      <% navigation.buttons.forEach(button => { %>
        <% if (!button?.type || !button?.text) return; %>

        <li class="nav-item ms-lg-2">
          <% if (button.type === "phone" && button.content) { %>
            <a
              href="tel:<%= String(button.content).replace(/[^\d+]/g, '') %>"
              class="btn btn-outline-primary d-inline-flex align-items-center justify-content-center"
            >
              <i class="fa fa-phone me-2"></i>
              <%= button.text %>
            </a>

          <% } else if (button.type === "link" && button.url) { %>
            <a
              href="<%= button.url %>"
              class="btn btn-outline-primary d-inline-flex align-items-center justify-content-center"
            >
              <%= button.text %>
            </a>
          <% } %>
        </li>
      <% }) %>
    <% } %>

    <% if (app.info.application_options?.versions?.pwa?.enabled || page.info.page_options.webapp) { %>
      <li class="nav-item ms-lg-2">
        <button
          id="downloadAppBtn"
          class="btn btn-primary d-inline-flex align-items-center justify-content-center pwa-download-button"
        >
          <i class="fa fa-download me-2"></i>
          Download app
        </button>
      </li>
    <% } %>

    <!-- Include the theme toggler -->
    <%- include('./themeToggler.ejs') %>
  </ul>
  