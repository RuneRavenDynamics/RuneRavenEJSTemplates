








<% 
    let navigation = page.info.page_settings.content.navigation || page.module.info.module_settings.content.navigation;
    let pageURL = data.url;
%>


<nav class="navbar navbar-expand-lg">
    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav" aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
        <span class="navbar-toggler-icon"></span>
    </button>
    <div class="collapse navbar-collapse" id="navbarNav">
        <ul class="nav nav-pills mx-auto" id="navigation-main" aria-label="Main Navigation">
            <% if (navigation && navigation.links) { %>
                <% navigation.links.forEach(link => { %>
                    <li class="nav-item" role="presentation">
                        <% if (link?.type === 'element_id') { %>
                        <a
                            href="#<%= link.element_id %>"
                            class="nav-link scroll-link fs-6"
                        >
                        <% } else { %>
                        <a
                            href="<%= link.url %>"
                            class="nav-link fs-6 <%= link.url === data.url ? 'active' : '' %>"
                        >
                        <% } %>
                            <% if (link.icon) { %>
                                <i class="<%= link.icon %>"></i>
                            <% } %>
                            <%=link.text %>
                        </a>
                    </li>
                <% }) %>
            <% } %>
        </ul>
        <% if (page.info.page_options.accounts) { %>
            <%- include('./accounts.ejs') %>
        <% } %>
    </div>
</nav>