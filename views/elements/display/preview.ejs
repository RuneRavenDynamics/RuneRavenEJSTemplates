








<style>
    .icon-container {
        width: 100px; /* Adjust size */
        height: 100px;
        background-color: #f8f9fa; /* Light background for contrast */
        border-radius: 50%; /* Makes it circular */
        display: flex;
        align-items: center;
        justify-content: center;
        box-shadow: 0px 4px 8px rgba(0, 0, 0, 0.2); /* Soft shadow */
    }

    .icon-container i {
        font-size: 50px; /* Adjust icon size */
        color: #007bff; /* Adjust color to match branding */
    }

</style>

<div class="container my-5">
    <div class="swiper swiper-preview">
        <div class="swiper-wrapper">
            <% for (let section of preview.sections) { %>
                <div class="swiper-slide">
                    <div class="d-flex flex-column align-items-center justify-content-center">
                        <div class="icon-container">
                            <i class="<%= section.icon %>"></i>
                        </div>
                        <div class="d-flex flex-column align-items-center justify-content-center">
                            <h5 class="my-2"><%= section.title %></h5>
                            <p class="mb-1"><%= section.description %></p>
                            <a href="<%= section.link %>" class="btn btn-primary scroll-link">Learn More »</a>
                        </div>
                    </div>
                </div>
            <% } %>
        </div>
        <!-- Swiper Navigation -->
        <div class="swiper-button-next"></div>
        <div class="swiper-button-prev"></div>

        <!-- Swiper Pagination -->
        <div class="swiper-pagination"></div>
    </div>
</div>