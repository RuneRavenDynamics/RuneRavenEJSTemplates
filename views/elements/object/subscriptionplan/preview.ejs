








<% 
    const p = infoOf(object);
    const variants = Object.values((p.subscription_settings.variation && p.subscription_settings.variation.variants) || {});
    const hasVariants = variants.length > 0;
    const basePrice = (p.price != null) ? formatMoney(p.subscription_settings.pricing.amount, p.subscription_settings.pricing.currency || 'USD') : null;
    const baseCadence = formatCadence(p.subscription_settings.schedule.recurrence);
%>
<div class="card h-100 border-primary-subtle">
    <div class="card-body">
    <div class="d-flex justify-content-between align-items-start">
        <div>
        <div class="fw-semibold"><%= p.name || 'Subscription Plan' %></div>
        <% if (p.description) { %>
            <div class="text-muted small"><%= p.description %></div>
        <% } %>
        </div>
        <% if (!hasVariants && baseCadence) { %>
        <span class="badge text-bg-light border"><%= baseCadence %></span>
        <% } %>
    </div>

    <% if (!hasVariants) { %>
        <div class="mt-3 d-flex align-items-baseline gap-2 variant-container">
        <% if (basePrice) { %>
            <div class="fs-4 fw-bold"><%= basePrice %></div>
        <% } %>
        </div>
    <% } else { %>
        <!-- Variant chips for short sets, list for longer sets -->
        <% if (variants.length <= 3) { %>
        <div class="mt-3 d-flex flex-wrap gap-2">
            <% variants.forEach(v => { 
                const price = formatPricing(v.settings.pricing, p.subscription_settings.pricing);
                const billing = formatCadence(v.settings.schedule.recurrence);
            %>
            <div class="d-inline-flex align-items-center gap-2 border rounded-pill px-3 py-2 variant-container">
                <span class="fw-semibold"><%= v.title || 'Plan' %></span>
                <span class="vr"></span>
                <span><%= price || 'Contact' %></span>
                <small class="text-muted">· <%= billing %></small>
                <% if (v.settings.pricing.discounts && v.settings.pricing.discounts.length > 0) { 
                    for (let d of v.settings.pricing.discounts) {  
                %>
                    <span class="badge text-bg-success">
                        <i class="fa-solid fa-tag me-1"></i>
                        <%= d.type === 'percent' ? `${d.amount}% off` : `-${formatMoney(d.amount, v.settings.pricing.currency || p.subscription_settings.pricing.currency || 'USD')}` %>
                    </span>
                <%    } 
                } %>
            </div>
            <% }) %>
        </div>
        <% } else { %>
        <ul class="list-group list-group-flush mt-3">
            <% variants.forEach(v => { 
                const price = formatPricing(v.settings.pricing, p.subscription_settings.pricing);
                const billing = formatCadence(v.settings.schedule.recurrence);
            %>
            <li class="list-group-item px-0 variant-container">
                <div class="d-flex justify-content-between align-items-start">
                <div>
                    <div class="fw-semibold"><%= v.title || 'Plan' %></div>
                    <div class="small text-muted"><%= billing %></div>
                    <% if (v.settings.pricing.discounts && v.settings.pricing.discounts.length > 0) { 
                        for (let d of v.settings.pricing.discounts) {  
                    %>
                        <span class="small text-success mt-1">
                            <i class="fa-solid fa-tag me-1"></i>
                            <%= d.type === 'percent' ? `${d.amount}% off` : `-${formatMoney(d.amount, v.settings.pricing.currency || p.subscription_settings.pricing.currency || 'USD')}` %>
                        </span>
                    <%    } 
                    } %>
                </div>
                <div class="text-end">
                    <div class="fw-semibold"><%= price || 'Contact' %></div>
                </div>
                </div>
            </li>
            <% }) %>
        </ul>
        <% } %>
    <% } %>
    </div>
    <% if (object.info.data.cta) { %>
        <div class="card-footer bg-transparent border-0">
            <a href="/contact" class="btn btn-outline-primary w-100 btn-sm">
                <i class="<%= object.info.data.cta.icon || 'fa-solid fa-cart-plus me-1' %>"></i>
                <%= object.info.data.cta.text || 'Select Plan' %>
            </a>
        </div>
    <% } %>
    
</div>
