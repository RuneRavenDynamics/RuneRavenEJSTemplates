<div class="container my-3">
  <div class="card shadow">
    <div class="card-header text-white">
      <h3 class="mb-0" id="event-form-title"></h3>
    </div>
    <div class="card-body" id="event-element">

    </div>
  </div>
</div>

<script type="module">
    import { api } from "https://cdn.runeravendynamics.com/clientapi/latest/api.bundle.js";

    await api.initialize();

    async function setupEvent() {
        const eventPaneTitle = document.querySelector('#event-form-title');
        const eventPane = document.querySelector("#event-element");

        api.tools.LM.load(true, eventPane);

        let data = <%- JSON.stringify({ options: element }) %>;
        let eventSettings = data.options.object.options;

        let event;
        if (data.options.object?.type && data.options.object?.id) {
            event = await api.graph.get(data.options.object.id, data.options.object.type);
        }
        let schedule = await api.graph.get(eventSettings.schedule.id, eventSettings.schedule.type);

        eventPane.innerHTML = "";

        let eventOptions = {
            id: `event-form-element`,
            content: null,
            element: "event",
            settings: {
                titleSettings: {
                    show: false
                },
                contentSettings: {
                    element: "form"
                },
                objectSettings: {
                    schedule,
                    eventSettings: {
                        name: {
                            content: eventSettings.name
                        },
                        description: {
                            content: eventSettings.description
                        },
                        type: {
                            content: eventSettings.type
                        },
                        duration: eventSettings?.duration || 60,
                        start: eventSettings?.period?.start || null,
                        end: eventSettings?.period?.end || null
                    }
                }
            },
            inherited: {
                object: event
            }
        }
        
        let eventElement = await api.elements.runeraven.createElement(eventOptions);
        eventPane.appendChild(eventElement);

        api.tools.LM.load(false, eventPane);
    }

    await setupEvent();
</script>