<div class="container my-3">
  <div class="card shadow">
    <div class="card-header text-white">
      <h3 class="mb-0" id="event-form-title"></h3>
    </div>
    <div class="card-body" id="event-element">

    </div>
  </div>
</div>

<script type="module">
    import { api } from "https://cdn.runeravendynamics.com/clientapi/latest/api.bundle.js";

    await api.initialize();

    async function setupEvent() {
        const eventPaneTitle = document.querySelector('#event-form-title');
        const eventPane = document.querySelector("#event-element");

        api.tools.LM.load(true, eventPane);

        eventPane.innerHTML = "";

        let eventOptions = {
            id: `event -form-element`,
            content: null,
            element: "estimate",
            settings: {
                titleSettings: {
                    show: false
                },
                contentSettings: {
                    element: "display"
                },
                objectSettings: {
                    estimateSettings: {
                        name: false,
                        description: false,
                        provider: false,
                        pricing: true,
                        email: false,
                        customers: false,
                        buttons: [
                            {
                                id: "deny-esimate-button",
                                type: "button",
                                className: "btn-danger",
                                HTML: "Cancel Estimate",
                                callback: async () => {
                                    api.tools.LM.load(true);
                                    await api.graph.callObjectMethod(esimate, "cancelEstimate", null, { refresh: false });
                                    api.tools.LM.load(false);
                                    api.tools.FLM.success("Estimate has been cancelled, please contact us if you have any questions or concerns.", 5000);
                                }
                            },
                            {
                                id: "accept-esimate-button",
                                type: "button",
                                className: "btn-primary",
                                HTML: "Accept Estimate",
                                callback: async () => {
                                    api.tools.LM.load(true);
                                    await api.graph.callObjectMethod(esimate, "acceptEstimate", null, { refresh: false });
                                    api.tools.LM.load(false);
                                    api.tools.FLM.success("Estimate has been accepted! We will be in touch shortly.", 5000);
                                }
                            }
                        ]
                    }
                }
            },
          inherited: {
            object: esimate
          }
      }
        let eventElement = await api.elements.runeraven.createElement(eventOptions);
        eventPane.appendChild(eventElement);

        api.tools.LM.load(false, eventPane);
    }

    await setupEstimate();
</script>