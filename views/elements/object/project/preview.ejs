








<style>
    .project-placeholder {
        height: 220px;
        background: linear-gradient(
            135deg,
            var(--bs-primary),
            var(--bs-secondary)
        );
    }
</style>

<div class="card shadow-sm h-auto p-3">
    <% if (Object.values(object.media.files)?.[0]?.url) { %>
        <img src="<%= Object.values(object.media.files)[0].url %>" class="card-img-top" alt="<%= object.info.description %>">
    <% } else { %>
        <div class="card-img-top d-flex align-items-center justify-content-center project-placeholder">
            <i class="<%= object?.info?.icon || 'fa-solid fa-diagram-project' %> fa-4x text-white opacity-75"></i>
        </div>
    <% } %>
    <div class="card-body text-center">
        <h5 class="card-title text-primary"><%= object.info.name %></h5>
        <% if (object?.elementId) { %>
            <a href="#<%= object.elementId %>" class="btn btn-primary scroll-link">View</a>
        <% } else if (object?.endpoint || object?.info?.endpoint) { %>
            <a href="<%= `https://${data.domain}${object?.endpoint || object?.info?.endpoint}` %>" class="btn btn-primary">View</a>
        <% } %>
    </div>
</div>