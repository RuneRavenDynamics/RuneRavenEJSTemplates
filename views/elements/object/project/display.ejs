








<style>

    /* Your gallery already has aspect-ratio. Keep paints small and predictable. */
    .swiper-project-gallery { contain: content; }        /* confine layout/paint */
    
    .swiper-project-gallery .swiper-slide:not(.swiper-slide-active) { filter: none; } /* avoid CSS filters on animating slides */

    .swiper-project-gallery .swiper-slide.swiper-slide-active {
    will-change: transform;
    }

    /* Put heavy shadows on non-animating wrappers, not the slide/img being translated */
    .swiper-project-gallery.shadow { box-shadow: 0 10px 24px rgba(0,0,0,.12); }
    .swiper-project-gallery .swiper-slide { box-shadow: none; }

    /* Avoid overflow: hidden on giant containers unless needed;
    use it on small components (like the gallery) only. */


    /* Gallery gets a consistent viewport */
    .swiper-project-gallery {
    width: 100%;
    /* pick one: either fixed height or aspect-ratio */
    /* height: 420px; */
    aspect-ratio: 16 / 9;     /* fluid height, consistent ratio */
    position: relative;
    overflow: hidden;          /* ensure nothing pokes out */
    }

    /* Make slides and wrapper match the gallery box */
    .swiper-project-gallery .swiper-wrapper,
    .swiper-project-gallery .swiper-slide {
    width: 100%;
    height: 100%;
    }

    /* Absolute-fill each image inside the slide */
    .swiper-project-gallery .swiper-slide {
    position: relative;
    overflow: hidden;          /* clip rounded corners, etc. */
    border-radius: .5rem;      /* optional, matches your .rounded */
    }

    .swiper-project-gallery .swiper-slide img {
    position: absolute;
    inset: 0;                  /* top/right/bottom/left: 0 */
    width: 100%;
    height: 100%;
    object-fit: cover;         /* fill & crop */
    object-position: center;
    }

    /* Optional: limit max height on large screens */
    @media (min-width: 992px) {
    .swiper-project-gallery {
        max-height: 520px;
    }
    }

    /* If you keep the separate .img-fluid .rounded classes, ensure they don't fight: */
    .swiper-project-gallery .swiper-slide img.img-fluid {
    height: 100% !important;   /* override Bootstrap's auto height */
    }

    /* Nice to have: ensure buttons/pagination overlay properly */
    .swiper-project-gallery .swiper-button-next,
    .swiper-project-gallery .swiper-button-prev,
    .swiper-project-gallery .swiper-pagination {
    color: #007bff;
    }

        /* Arrows on top, always clickable */
    .swiper-project-gallery .swiper-button-next,
    .swiper-project-gallery .swiper-button-prev {
    z-index: 20;
    pointer-events: all;
    }

    /* Make the media layer non-interactive */
    .swiper-project-gallery .swiper-slide picture,
    .swiper-project-gallery .swiper-slide img {
    pointer-events: none;
    }


    /* keep this on the big section (good for perf) */
    .project-section {

    }

    /* but NEVER on the swiper box: let it be measurable */
    .swiper-project-gallery {
    contain: paint; /* not content */
    }

    /* Edge flicker guard: */
    .swiper-project-gallery .swiper-slide {
    backface-visibility: hidden;
    transform: translateZ(0); /* promote layer to prevent flicker */
    }



</style>

<% if (object && object.info) { %>
    <section id="<%= object?.elementId || `project-${object.info.id}` %>" class="project-section container my-5 py-5 border-bottom overflow-hidden">
        <div class="row align-items-center gy-4">
            <!-- Media Section -->
            <% const mediaFiles = object.media?.files || {}; %>
            <% const mediaKeys = Object.keys(mediaFiles); %>
            <div class="col-lg-6 h-100">
                <% if (mediaKeys.length === 1) { %>
                    <img src="<%= mediaFiles[mediaKeys[0]].url %>" alt="<%= mediaKeys[0] %>" class="img-fluid rounded shadow" loading="lazy">
                <% } else if (mediaKeys.length > 1) { %>
                    <% 
                        let slideshowOptions = {
                            id: `${object.info.uoid}-slideshow`,
                            type: "swiper-project-gallery",
                            slides: mediaFiles,
                            options: {
                                navigation: true,
                                pagination: true
                            }
                        };
                    %>
                    <%- include('../../media/slideshow', { slideshow: slideshowOptions }) %>
                <% } %>
            </div>
    
            <!-- Project Info -->
            <div class="col-lg-6">
                <h3 class="fw-bold"><%= object.info.name %></h3>
                <p class="text-muted"><%= object.info.description %></p>
                <p><%= object.info.long_description %></p>
    
                <% if (object.info.status) { %>
                    <p class="badge bg-secondary">Status: <%= object.info.status %></p>
                <% } %>
    
                <% if (object.info.review && object.info.review.rating) { %>
                    <p><strong>Client Review:</strong></p>
                    <blockquote class="blockquote">
                        <p><%= object.info.review.text %></p>
                        <footer class="blockquote-footer">Rating: <%= object.info.review.rating %>/5</footer>
                    </blockquote>
                <% } %>
    
                <% if (object.info.customers && Object.keys(object.info.customers).length > 0) { %>
                    <div>
                        <p class="fw-semibold">Customers:</p>
                        <ul class="list-inline">
                            <% for (let customerKey in object.info.customers) { %>
                                <li class="list-inline-item badge bg-info text-dark me-1">
                                    <%= object.info.customers[customerKey].name || customerKey %>
                                </li>
                            <% } %>
                        </ul>
                    </div>
                <% } %>

                <% if (object.info.data.cta) { %>
                    <div class="mt-4">
                        <a href="<%= object.info.data.cta.url %>" class="btn btn-primary">
                            <%= object.info.data.cta.text || 'View Details' %>
                        </a>
                    </div>
                <% } %>

            </div>
        </div>
    </section>
<% } else { %>
    <p class="text-center text-muted">Project not found.</p>
<% } %>
    