








<style>

    #business-service-section {
      margin-top: 5%;
    }

    .swiper-media-cube {
        width: 100%;
        height: 100%;
    }

    .swiper-media-cube .swiper-slide {
        overflow: hidden;
    }

    .swiper-media-cube .swiper-slide img {
        width: 100%;
        height: 100%;
        object-fit: cover;       /* Scale the image to fill the container and crop if necessary */
        object-position: center; /* Keep the image centered */
    }

    .swiper-button-next,
    .swiper-button-prev {
        color: #007bff;
    }

    .swiper-pagination-bullet-active {
        background: #007bff;
    }

    .fact-chip {
    background: var(--bs-body-bg);
    border: 1px solid var(--bs-primary);
  }
  .fact-chip i { font-size: 1rem; color: var(--bs-primary); }

</style>


<% if (object && object.info) { %>

    <%
    function buildElement(c) {
    %>

        <% if (c?.type === "description") { %>
            <div style="<%= formatElementStyles(c?.styles || {}) %>">
                <p><%= object.info.description %></p>
            </div>

        <% } else if (c?.type === "long_description") { %>
            <div style="<%= formatElementStyles(c?.styles || {}) %>">
                <p><%= object.info.long_description %></p>
            </div>

        <% } else if (c?.type === "quick_facts") { %>
            <%
                const quickFacts = [
                    {
                        icon: "fa-solid fa-layer-group",
                        label: "Type",
                        value: object.info.service_settings?.type
                            ? formatHeading(object.info.service_settings.type)
                            : null
                    },
                    {
                        icon: "fa-solid fa-tag",
                        label: "Base price",
                        value: object.info.service_settings?.pricing?.amount != null
                            ? formatMoney(
                                object.info.service_settings.pricing.amount,
                                object.info.service_settings.pricing.currency
                            )
                            : null
                    },
                    {
                        icon: "fa-regular fa-clock",
                        label: "Duration",
                        value: object.info.service_settings?.schedule?.duration?.period
                            ? formatDuration(
                                object.info.service_settings.schedule.duration.period,
                                object.info.service_settings.schedule.duration.period_type
                            )
                            : null
                    },
                    {
                        icon: "fa-solid fa-rotate",
                        label: "Frequency",
                        value: object.info.service_settings?.schedule?.recurrence
                            ? formatCadence(
                                object.info.service_settings.schedule.recurrence
                            )
                            : null
                    }
                ].filter(fact => fact.value);
            %>

            <% if (c?.enabled !== false && quickFacts.length) { %>
                <div style="<%= formatElementStyles(c?.styles || {}) %>">
                    <div class="card shadow-sm border-0 mt-3">
                        <div class="card-body py-3">
                            <div class="d-flex flex-wrap justify-content-start gap-2">
                                <% quickFacts.forEach(fact => { %>
                                    <div class="fact-chip d-inline-flex align-items-center gap-2 px-3 py-2 rounded">
                                        <i class="<%= fact.icon %>"></i>
                                        <div class="d-flex flex-column gap-2 lh-1">
                                            <small class="text-muted"><%= fact.label %></small>
                                            <strong><%= fact.value %></strong>
                                        </div>
                                    </div>
                                <% }) %>
                            </div>
                        </div>
                    </div>
                </div>
            <% } %>

        <% } else if (c?.type === "call_to_action") { %>
            <%
                const ctaText = c?.text?.trim()
                    || object?.info?.data?.cta?.text?.trim()
                    || "Contact Us";

                const ctaUrl = c?.url?.trim()
                    || object?.info?.data?.cta?.url?.trim()
                    || "/contact";

                const isExternal = /^https?:\/\//i.test(ctaUrl);
            %>

            <% if (c?.enabled !== false) { %>
                <div style="<%= formatElementStyles(c?.styles || {}) %>">
                    <div class="mt-3 d-flex align-items-center justify-content-center">
                        <a
                            href="<%= ctaUrl %>"
                            class="btn btn-primary btn-lg"
                            <% if (isExternal) { %>
                                target="_blank"
                                rel="noopener noreferrer"
                            <% } %>
                        >
                            <i class="fa-solid fa-paper-plane me-2"></i>
                            <%= ctaText %>
                        </a>
                    </div>
                </div>
            <% } %>

        <% } else if (c?.type === "media") { %>
            <div class="mb-4 vh-50" style="<%= formatElementStyles(c?.styles || {}) %>">
                <div class="rounded shadow w-100 h-100">
                    <%
                        const slideshowOptions = {
                            id: `${object.info.uoid}-slideshow`,
                            type: "swiper-media-cube",
                            slides: object.media.files,
                            options: {
                                navigation: true,
                                pagination: true
                            }
                        };
                    %>

                    <%- include("../../media/slideshow", {
                        slideshow: slideshowOptions
                    }) %>
                </div>
            </div>

        <% } else if (c?.type === "subscription_plans") { %>
            <%
                const plans = Object.values(
                    object?.objects?.subscriptionPlan || {}
                );
            %>

            <% if (plans.length) { %>
                <%- include("../subscriptionplan/list", {
                    objects: {
                        title: "Subscription Plans",
                        objects: plans
                    }
                }) %>
            <% } %>

        <% } else if (c?.type === "schedule") { %>
            <% if (
                object.info.service_settings?.schedule?.recurrence?.recurring &&
                object.info.service_settings?.schedule?.recurrence?.options
            ) { %>
                <%- include("../../property/schedule", {
                    content: {
                        schedule: object.info.service_settings.schedule,
                        title: "Schedules"
                    }
                }) %>
            <% } %>

        <% } else if (c?.type === "details") { %>
            <% if (object.info.details) { %>
                <%- include("../../property/features", {
                    content: {
                        id: `${object.info.uoid}-features`,
                        type: c?.options?.type || "accordion",
                        title: c?.options?.title || "Details",
                        items: Object.values(object.info.details || {})
                    }
                }) %>
            <% } %>
        <% } else if (c?.type === 'container') { %>
              <div style="<%= formatElementStyles(c?.styles || {}) %>">
                    <% for (const sc of c?.options?.content || []) { %>
                          <% buildElement(sc); %>
                    <% } %>
                </div>
        <% } %>

    <%
    }
    %>

    <section class="container mb-5">
        <!-- header stays here -->

        <div class="row gy-4 mb-5 justify-content-center">
            <% for (const c of element?.object?.options?.content || []) { %>
                <% buildElement(c); %>
            <% } %>
        </div>
    </section>

<% } else { %>
    <p>Service not found.</p>
<% } %>
    