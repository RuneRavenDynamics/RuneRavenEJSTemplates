








<style>

    #business-service-section {
      margin-top: 5%;
    }

    .swiper-media-cube {
        width: 100%;
        height: 100%;
    }

    .swiper-media-cube .swiper-slide {
        overflow: hidden;
    }

    .swiper-media-cube .swiper-slide img {
        width: 100%;
        height: 100%;
        object-fit: cover;       /* Scale the image to fill the container and crop if necessary */
        object-position: center; /* Keep the image centered */
    }

    .swiper-button-next,
    .swiper-button-prev {
        color: #007bff;
    }

    .swiper-pagination-bullet-active {
        background: #007bff;
    }

    .fact-chip {
    background: var(--bs-body-bg);
    border: 1px solid var(--bs-primary);
  }
  .fact-chip i { font-size: 1rem; color: var(--bs-primary); }

  .rr-element-container {
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      gap: 1.5rem;
  }

  .rr-element {
      flex: 0 0 var(--rr-element-width);
      width: var(--rr-element-width);
      max-width: 100%;
  }

  /* Phone/tablet: every configured element becomes its own full-width row */
  @media (max-width: 767.98px) {
      .rr-element {
          flex-basis: 100%;
          width: 100%;
          max-width: 100%;
      }
  }

</style>



<% if (object && object.info) { %>

  <%
  function buildElement(c) {
  %>

    <%
        const styles = c?.styles || [];

        const widthStyle = styles.find(style => style?.type === "width");
        const width = widthStyle?.value || "100%";

        const otherStyles = styles.filter(
            style => style?.type !== "width"
        );

        c.formatted = formatElementStyles(otherStyles);

        c.formatted.styles = `--rr-element-width: ${width}; ${c.formatted.styles}`;
    %>

    <% if (c?.type === 'description') { %> 
        <div style="<%= c?.formatted?.styles || "" %>" class="rr-element <%= c?.formatted?.classes || "" %>">
          <p><%= object.info.description %></p>
        </div>
    <% } else if (c?.type === 'long_description') { %> 
        <div style="<%= c?.formatted?.styles || "" %>" class="rr-element <%= c?.formatted?.classes || "" %>">
          <p><%= object.info.long_description %></p>
        </div>
    <% } else if (c?.type === 'quick_facts') { %> 
        <div style="<%= c?.formatted?.styles || "" %>" class="rr-element <%= c?.formatted?.classes || "" %>">
            <% const quickFacts = [
                { icon: 'fa-solid fa-layer-group', label: 'Type',     value: object.info.service_settings?.type ? formatHeading(object.info.service_settings.type) : null },
                { icon: 'fa-solid fa-tag',      label: 'Base price',  value: formatMoney(object.info.service_settings.pricing.amount, object.info.service_settings.pricing.currency) },
                { icon: 'fa-regular fa-clock',  label: 'Duration',    value: formatDuration(object.info.service_settings.schedule.duration.period, object.info.service_settings.schedule.duration.period_type) },
                { icon: 'fa-solid fa-rotate',   label: 'Frequency',     value: formatCadence(object.info.service_settings.schedule.recurrence) }
              ].filter(x => x.value); %>

              <% if (c?.enabled && quickFacts.length) { %>
                <div class="card shadow-sm border-0 mt-3" aria-label="Service quick facts">
                  <div class="card-body py-3">
                    <div class="d-flex flex-wrap justify-content-start gap-2">
                      <% quickFacts.forEach(f => { %>
                        <div class="fact-chip d-inline-flex align-items-center gap-2 px-3 py-2 rounded">
                          <i class="<%= f.icon %>"></i>
                          <div class="d-flex flex-column gap-2 lh-1">
                            <small class="text-muted"><%= f.label %></small>
                            <strong><%= f.value %></strong>
                          </div>
                        </div>
                      <% }) %>
                    </div>
                  </div>
                </div>
              <% } %>
        </div>
    <% } else if (c?.type === 'call_to_action') { %> 
        <div style="<%= c?.formatted?.styles || "" %>" class="rr-element d-flex flex-column align-items-center justify-content-evenly <%= c?.formatted?.classes || "" %>">
          <% if (c?.enabled) { %>
            <% let divide = false; %>

            <% if (c?.options?.booking?.enabled) { %>
              <% if (divide) { %>
                <%- include('../../utility/divider', { context: { orientation: "horizontal", text: "OR" } }) %>
              <% } %>

              <div id="event-element" class="w-90">

              </div>
              <script type="module">
                import { api } from "https://cdn.runeravendynamics.com/clientapi/latest/api.bundle.js";

                await api.initialize();
                
                let data = <%- JSON.stringify({ options: c.options.booking }) %>;
                const eventContainer = document.querySelector("#event-element");
                const eventPane = document.createElement('div');
                eventPane.className = "p-4";

                let bookingButton = await api.elements.element({
                  api: "bootstrap",
                  element: "accordionitem",
                  id: "booking-button",
                  title: `<h3 class="mb-0 fs-6">${data.options?.name || "Schedule Appointment"}</h3>`,
                  content: eventPane,
                  parent: eventContainer
                })

                async function setupEvent() {                    

                  api.tools.LM.load(true, eventPane);
                  
                  let eventSettings = data.options;

                  let event = {
                      info: {
                          type: "scheduleEvent",
                          name: eventSettings.name,
                          description: eventSettings.description,
                          event_settings: {
                              type: eventSettings.type
                          }
                      }
                  }
                  let schedule = await api.graph.get(eventSettings.schedule.id, eventSettings.schedule.type);

                  eventPane.innerHTML = "";

                  let eventOptions = {
                      id: `event-form-element`,
                      content: null,
                      element: "booking",
                      settings: {
                          titleSettings: {
                              show: false
                          },
                          contentSettings: {
                              element: "form"
                          },
                          objectSettings: {
                              business: api.app.data.business,
                              schedule,
                              bookingSettings: {
                                  steps: [
                                      'event'
                                  ],
                                  eventSettings: {
                                      flow: "steps",
                                      name: false,
                                      description: {
                                          content: eventSettings.description
                                      },
                                      customer: true,
                                      duration: eventSettings?.duration || 60,
                                      period: eventSettings?.period || null,
                                  }
                              }
                          }
                      },
                      inherited: {
                          object: event
                      }
                  }
                  
                  let eventElement = await api.elements.runeraven.createElement(eventOptions);
                  eventPane.appendChild(eventElement);
                  await api.graph.elements.callDisplayCallbacksWhenConnected(eventElement);

                  api.tools.LM.load(false, eventPane);
                }

                await setupEvent();
              </script>

                <% divide = true; %>
            <% } %>

            <% if (c?.options?.payment?.enabled) { %>
              <% if (divide) { %>
                <%- include('../../utility/divider', { context: { orientation: "horizontal", text: "OR" } }) %>
              <% } %>

              <% divide = true; %>
            <% } %>

            <% if (c?.options?.contact?.enabled) { %>
              <% if (divide) { %>
                <%- include('../../utility/divider', { context: { orientation: "horizontal", text: "OR" } }) %>
              <% } %>

              <%
                const cta = c.options.contact;
                cta.text = cta?.text || object?.info?.data?.cta?.text || null;
                cta.url = cta?.url || object?.info?.data?.cta?.url || null;
                const ctaText = (cta && typeof cta.text === 'string' && cta.text.trim()) ? cta.text.trim() : 'Contact Us';
                const ctaUrl  = (cta && typeof cta.url  === 'string' && cta.url.trim())  ? cta.url.trim()  : '/contact';
                const isExternal = /^https?:\/\//i.test(ctaUrl);
              %>
              <div class="mt-3 d-flex align-items-center justify-content-center">
                <a
                  href="<%= ctaUrl %>"
                  class="btn btn-primary btn-lg"
                  <% if (isExternal) { %> target="_blank" rel="noopener noreferrer" <% } %>>
                  <i class="fa-solid fa-paper-plane me-2"></i><%= ctaText %>
                </a>
              </div>

              <% divide = true; %>
            <% } %>
            
          <% } %>
        </div>
    <% } else if (c?.type === 'media') { %>

          <div style="<%= c?.formatted?.styles || "" %>" class="rr-element mb-4 vh-50 <%= c?.formatted?.classes || "" %>">
            <!-- Media / Slider -->
            <div class="rounded shadow w-100 h-100">
              <% 
                  let slideshowOptions = {
                      id: `${object.info.uoid}-slideshow`,
                      type: "swiper-media-cube",
                      slides: object.media.files,
                      options: {
                          navigation: true,
                          pagination: true
                      }
                  };
              %>
              <%- include('../../media/slideshow', { slideshow: slideshowOptions }) %>
            </div>
          </div>

    <% } else if (c?.type === 'subscription_plans') { %>

        <% if (Object.keys(object?.objects?.subscriptionPlan || {}).length) { 
          let plans = Object.values(object.objects.subscriptionPlan);
          %>
          <%- include('../subscriptionplan/list', { 
            objects: {
              title: "Subscription Plans",
              objects: plans,
            }
          }) %>
          
        <% } %>

    <% } else if (c?.type === 'schedule') { %>

        <% if (object.info.service_settings.schedule.recurrence.recurring && object.info.service_settings.schedule.recurrence.options) { %>
          <%- include('../../property/schedule', { 
            content: {
              schedule: object.info.service_settings.schedule,
              title: `Schedules`
            }
          }) %>
        <% } %>
    
    <% } else if (c?.type === 'details') { %>
  
        <% if (object.info.details) { %>
          <%- include('../../property/features', { 
            content: {
              id: `${object.info.uoid}-features`,
              type: c?.options?.type || "accordion",
              title: c?.options?.title || "Details",
              items: Object.values(object.info?.details || {})
            }
          }) %>
        <% } %>

    <% } else if (c?.type === 'container') { %>
          <div style="<%= c?.formatted?.styles || "" %>" class="rr-element <%= c?.formatted?.classes || "" %>">
                <% for (const sc of c?.options?.content || []) { %>
                      <% buildElement(sc); %>
                <% } %>
            </div>
    <% } %>

  <% } %>

    <section class="container mb-5">
        <div class="row gy-5 my-5">
            <div class="col-12">
                <h2 class="text-center fw-bold"><%= object.info.name %></h2>
            </div>
        </div>
        
        <div class="rr-element-container">
            <% for (const c of element?.object?.options?.content || []) { %>
                <% buildElement(c); %>
            <% } %>
        </div>
          
    </section>

<% } else { %>
    <p>Service not found.</p>
<% } %>
    