








<style>
  .contact-wrapper {
    background: var(--bs-body-bg, white);
    border-radius: 20px;
    overflow: hidden;
    box-shadow: 0 5px 30px rgba(0, 0, 0, 0.1);
  }

  .contact-info {
    /* Use brand colors from the variables for the gradient */
    background: linear-gradient(135deg, var(--bs-primary), var(--bs-secondary));
    padding: 40px;
    color: var(--bs-body-color, #ffffff);
  }

  .contact-item {
    display: flex;
    align-items: center;
    margin-bottom: 25px;
    transition: all 0.3s ease;
  }

  .contact-item:hover {
    transform: translateX(10px);
  }

  .contact-icon {
    width: 40px;
    height: 40px;
    background: rgba(255, 255, 255, 0.2);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-right: 15px;
  }

  .social-links {
    margin-top: 30px;
  }

  .social-icon {
    width: 35px;
    height: 35px;
    background: rgba(255, 255, 255, 0.2);
    border-radius: 50%;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    margin-right: 10px;
    transition: all 0.3s ease;
  }

  .social-icon:hover {
    background: var(--bs-body-bg);
    color: var(--bs-primary);
    transform: translateY(-3px);
  }

  .contact-form {
    padding: 40px;
  }

  .form-control {
    border-radius: 10px;
    padding: 12px 15px;
    border: 2px solid #eee;
    transition: all 0.3s ease;
  }

  .form-control:focus {
    border-color: var(--bs-primary);
    box-shadow: none;
  }

  .form-label {
    font-weight: 500;
    margin-bottom: 8px;
  }

  .btn-submit {
    background: linear-gradient(135deg, var(--bs-primary), var(--bs-secondary));
    border: none;
    padding: 12px 30px;
    border-radius: 10px;
    transition: all 0.3s ease;
  }

  .btn-submit:hover {
    transform: translateY(-2px);
    box-shadow: 0 5px 15px rgba(13, 110, 253, 0.3); /* or use a custom var if needed */
  }

  .map-container {
    height: 200px;
    border-radius: 10px;
    overflow: hidden;
    margin-top: 20px;
  }
</style>




<div class="row justify-content-center">
    <div class="col-lg-10">
        <div class="contact-wrapper parallax-up">
        <div class="row g-0">
            <!-- Left: Contact Info Section -->
            <div class="col-md-5">
                <div class="contact-info h-100">
                    <h3 class="mb-4">Get in touch</h3>
                    <p class="mb-4">
                    We'd love to hear from you. Please fill out the form or contact us using the information below.
                    </p>
    
                    <!-- Phone -->
                    <div class="contact-item">
                    <div class="contact-icon">
                        <i class="fas fa-phone"></i>
                    </div>
                    <div>
                        <h6 class="mb-0">Phone</h6>
                        <% if (object.info && object.info.contact && object.info.contact.phone && object.info.contact.phone.primary) { %>
                        <p class="mb-0"><a href="tel:<%= object.info.contact.phone.primary %>" class="text-white text-decoration-none">
                            <%= object.info.contact.phone.primary %>
                        </a></p>
                        <% } else { %>
                        <p class="mb-0">Phone not available.</p>
                        <% } %>
                    </div>
                    </div>
    
                    <!-- Email -->
                    <div class="contact-item">
                    <div class="contact-icon">
                        <i class="fas fa-envelope"></i>
                    </div>
                    <div>
                        <h6 class="mb-0">Email</h6>
                        <% if (object.info && object.info.contact && object.info.contact.email && object.info.contact.email.primary) { %>
                        <p class="mb-0"><a href="mailto:<%= object.info.contact.email.primary %>" class="text-white text-decoration-none">
                            <%= object.info.contact.email.primary %>
                        </a></p>
                        <% } else { %>
                        <p class="mb-0">Email not available.</p>
                        <% } %>
                    </div>
                    </div>

                    <!-- Address -->
                    <div class="contact-item">
                    <div class="contact-icon">
                        <i class="fas fa-map-marker-alt"></i>
                    </div>
                    <div>
                        <h6 class="mb-0">Address</h6>
                        <% if (object.info && object.info.address) { %>
                        <p class="mb-0">
                            <%= `${object.info.address.line1}, ${object.info.address?.line2 || ''}` %>, 
                            <%= object.info.address.city %>, 
                            <%= object.info.address.state %> 
                            <%= object.info.address.postal_code %><br>
                            <%= object.info.address.country %>
                        </p>
                        <% } else { %>
                        <p class="mb-0">Address not available.</p>
                        <% } %>
                    </div>
                    </div>
                    
                    <!-- Map Container -->
                    <div class="map-container my-4">
                    <% if (object.info && object.info.mapEmbed) { %>
                        <%= object.info.mapEmbed %>
                    <% } else if (object.info && object.info.address) { 
                            // Generate a dynamic Google Maps embed using the address details
                            const addrParts = [];
                            if (object.info.address.line1) addrParts.push(`${object.info.address.line1}, ${object.info.address?.line2 || ''}`);
                            if (object.info.address.city) addrParts.push(object.info.address.city);
                            if (object.info.address.state) addrParts.push(object.info.address.state);
                            if (object.info.address.postal_code) addrParts.push(object.info.address.postal_code);
                            if (object.info.address.country) addrParts.push(object.info.address.country);
                            const query = encodeURIComponent(addrParts.join(' '));
                            const googleMapEmbed = `<iframe src="https://www.google.com/maps/embed/v1/place?key=${keys.google}&q=${query}" width="600" height="450" style="border:0;" allowfullscreen="" loading="lazy"></iframe>`;
                    %>
                        <%- googleMapEmbed %>
                    <% } else { %>
                        <img src="/api/placeholder/800/200" alt="Map" style="width: 100%; height: 100%; object-fit: cover;">
                    <% } %>
                    </div>
    
                    <!-- Social Links -->
                    <div class="social-links">
                    <h6 class="mb-3">Follow Us</h6>
                    <% if (object.info && object.info.social) { 
                        for (let platform in object.info.social) {
                            let url = object.info.social[platform];
                            if (url) { %>
                    <a href="<%= url %>" class="social-icon" target="_blank">
                        <i class="fab fa-<%= platform %>"></i>
                    </a>
                    <% } } } else { %>
                        <p>No social links available.</p>
                    <% } %>
                    </div>
                </div>
            </div>
            
            <!-- Right: Contact Form Section -->
            <div class="col-md-7">
                <div class="contact-form">
                    <h3 class="mb-4">Send us a message</h3>
                    <form id="contact-lead-form">
                        <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label">First Name</label>
                            <input type="text" class="form-control" name="first_name" placeholder="John">
                        </div>
                        
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Last Name</label>
                            <input type="text" class="form-control" name="last_name" placeholder="Doe">
                        </div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Phone</label>
                            <input type="tel" class="form-control" name="phone" placeholder="+1 (555) 123-4567">
                        </div>
                        
                        <div class="mb-3">
                            <label class="form-label">Email</label>
                            <input type="email" class="form-control" name="email" placeholder="john@example.com">
                        </div>
                        
                        <div class="mb-3">
                            <label class="form-label">Subject</label>
                            <input type="text" class="form-control" name="subject" placeholder="How can we help?">
                        </div>
                        
                        <div class="mb-4">
                            <label class="form-label">Message</label>
                            <textarea class="form-control" rows="5" name="message" placeholder="Your message here..."></textarea>
                        </div>
                        
                        <button type="button" id="submit-business-lead-button" class="btn btn-submit text-white">Send Message</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<script type="module">
    import { api } from "https://cdn.runeravendynamics.com/clientapi/latest/api.bundle.js";

    await api.initialize();

    let notifyEmail = <%- JSON.stringify(object?.email || null) %>;
    let leadButton = document.querySelector('#submit-business-lead-button');
    leadButton.addEventListener('click', async function() {
      const form = document.querySelector('#contact-lead-form');
      const formData = new FormData(form);
      const formObject = Object.fromEntries(formData.entries());

      // Send the form data to the server
      formObject.type = 'lead';
      if (notifyEmail) {
        formObject.notify_email = notifyEmail;
      }
      api.tools.LM.load(true);
      api.tools.RM.setHost(window.location.host);
      await api.tools.RM.send('contact/form', 'POST', formObject, true);
      api.tools.LM.load(false);
      form.reset();
      alert('Your message has been sent. We will get back to you shortly!');
    });
</script>