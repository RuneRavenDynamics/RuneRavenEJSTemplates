<style>

    .swiper-gallery .swiper-slide {
        /* Enforce a consistent aspect ratio, for example 16:9 */
        aspect-ratio: 16 / 9;
        /* Make sure the slide itself is positioned relative or block-level */
        overflow: hidden; /* hide any overflow from child elements */
    }

    .swiper-gallery .swiper-slide img {
        width: 100%;
        height: 100%;
        object-fit: cover;       /* Crop to fill container */
        object-position: center; /* Center the cropping */
        display: block;          /* Avoid inline spacing issues */
    }

    .swiper-preview .card {
        display: flex;
        flex-direction: column; /* So card-body stays at bottom */
        width: 90%;
    }

    /* 2) Restrict the image area and crop using object-fit */
    .swiper-preview .card-img-top {
        flex-shrink: 0;      /* Prevent the image from shrinking if text is large */
        width: 100%;
        height: 200px;       /* Reserve a fixed 200px for the image */
        object-fit: cover;   /* Crop to fill the area */
        object-position: 50% 50%; /* Center focal point */
    }

</style>

<% for (let container of elementData.objects) { 
    container.elementId = crypto.randomUUID();
    container.template = "slideshow";
    if (container && container.info && container.info.data && container.info.data.thumbnail) {
        container.thumbnail = container.info.data.thumbnail;
    } else {
        let media = Object.values(container.media.files)[0];
        container.thumbnail = {
            url: media.url,
            alt: container.info.description
        }
    }
} %>

<section class="vw-100 vh-50" <%= typeof scrollElement !== 'undefined' && scrollElement ? 'data-scroll-section' : '' %>>

    <!-- Galleries Previews -->
    <div class="container-fluid h-auto">
        <div class="row">
            <div class="swiper swiper-preview w-100 p-5">
                <div class="swiper-wrapper">
                    <% for (const container of elementData.objects) { %>
                        <div class="swiper-slide">
                            <%- include('../../object/container/preview', { object: container }) %>
                        </div>
                    <% } %>
                </div>

                <!-- Swiper Navigation Buttons -->
                <div class="swiper-button-next"></div>
                <div class="swiper-button-prev"></div>

                <!-- Swiper Pagination -->
                <div class="swiper-pagination"></div>
            </div>
        </div>
    </div>
</section>



<section id="<%= elementId %>" style="<%= formatElementStyles(element.styles || []) %>" <%= typeof scrollElement !== 'undefined' && scrollElement ? 'data-scroll-section' : '' %>>
    <%- include(`../../object/container/list`, {objects: elementData}) %>
</section>
