








<style>
    .swiper-preview .card {
        display: flex;
        flex-direction: column; /* So card-body stays at bottom */
        width: 90%;
    }

    /* 2) Restrict the image area and crop using object-fit */
    .swiper-preview .card-img-top {
        flex-shrink: 0;      /* Prevent the image from shrinking if text is large */
        width: 100%;
        height: 200px;       /* Reserve a fixed 200px for the image */
        object-fit: cover;   /* Crop to fill the area */
        object-position: 50% 50%; /* Center focal point */
    }

</style>


<div id="<%= elementId %>" style="<%= formatElementStyles(element.styles || []) %>" <%= typeof scrollElement !== 'undefined' && scrollElement ? 'data-scroll-section' : '' %>>

    <section class="vw-100 h-auto">

        <!-- Projects Previews -->
        <div class="container-fluid h-auto">
            <div class="row">
                <div class="swiper swiper-preview w-100 p-5">
                    <div class="swiper-wrapper">
                        <% for (const project of elementData.objects) {
                            project.elementId = `project-${project.info.id}`;
                        %>
                            <div class="swiper-slide">
                                <%- include('../../object/project/preview', { object: project }) %>
                            </div>
                        <% } %>
                        
                    </div>

                    <!-- Swiper Navigation Buttons -->
                    <div class="swiper-button-next"></div>
                    <div class="swiper-button-prev"></div>

                    <!-- Swiper Pagination -->
                    <div class="swiper-pagination"></div>
                </div>
            </div>
        </div>
    </section>


    <%- include(`../../object/project/list`, { objects: elementData }) %>
</div>

