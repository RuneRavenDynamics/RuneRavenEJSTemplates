








<button type="button" id="<%= elementId %>" style="<%= formatElementStyles(element.styles || []) %>" <%= typeof scrollElement !== 'undefined' && scrollElement ? 'data-scroll-section' : '' %>>
    <%- include('../../media/carousel', {
        slideshow: {
            id: `business-hero-${elementId}`,
            type: element.element.options?.type || "swiper-gallery",
            title: element.element.options.title,
            description: element.element.options.message,
            slides: element.element.options.slides
        }
    }) %>
</button>