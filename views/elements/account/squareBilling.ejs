<!-- inside #billing-tab-pane ... -->
<div class="container my-3">
  <div class="card shadow">
    <div class="card-header text-white">
      <h3 class="mb-0">Billing</h3>
    </div>
    <div class="card-body">

    </div>
  </div>
</div>

<script type="module">
    import { api } from "https://cdn.runeravendynamics.com/clientapi/latest/api.bundle.js";

    await api.initialize();

    async function setupBilling() {
      const billingPane = document.querySelector("#billing-tab-pane .card-body");

      const squareaccount = await api.graph.getNode(api.tools.A.info.business, "children", { type: "squareaccount" });

      const customer = await api.graph.getNode(api.tools.A.info.user, "siblings", { type: "customer" });

      if (!stripeaccount) {
          console.log("No Square account found for business.");
          return;
      }

      if (!customer?.info?.third_party?.stripe?.id) {
          console.log("No Square customer ID found for user/customer.");
          return;
      }

      billingPane.innerHTML = "";

      await api.finance.element({
          element: "paymentmethodselect",
          provider: "square",
          id: "account-billing-paymentselect",
          parent: billingPane,
          squareaccount,
          customer
      });
    }

    await setupBilling();
</script>
