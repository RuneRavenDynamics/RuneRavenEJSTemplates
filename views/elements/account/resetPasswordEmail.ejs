







<div class="container d-flex align-items-center justify-content-center vh-90">
    <div class="reset-password-form-container container text-center" id="overlay-container">
        <h2 class="reset-password-form-title orbitron"><%= business.info.name %> Account Password Reset</h2>
        <form action="https://<%= data.domain %>/account/email_password_reset" method="post">
            <div class="mb-3 row">
                <label class="orbitron col-sm-2 col-form-label" for="email">Email of your account:</label>
                <div class="col-sm-10">
                    <input type="email" class="form-control" id="email" name="email" required>
                </div>
            </div>
            
            <button type="submit" id="app-login-button" class="btn btn-primary">Request Password Reset Link</button>
            
            <hr/>
            
        </form>
    </div>
</div>