<div class="container my-3">
  <div class="card shadow">
    <div class="card-header text-white">
      <h3 class="mb-0">Checkout</h3>
    </div>
    <div class="card-body" id="payment-checkout-element">

    </div>
  </div>
</div>

<script type="module">
    import { api } from "https://cdn.runeravendynamics.com/clientapi/latest/api.bundle.js";

    await api.initialize();

    async function setupBilling() {
      const billingPane = document.querySelector("#payment-checkout-element");

      api.tools.LM.load(true, billingPane);

      let paymentDataElement = document.querySelector('#payment-data-element');
      let data = JSON.parse(paymentDataElement.textContent);

      let squareaccount;
      let business;
      
      if (data?.options?.provider?.id) {
        squareaccount = await api.graph.get(data.options.provider.id, "squareaccount");
        business = await api.graph.getNode(squareaccount, "parents", { type: "business" });
      } else {
        squareaccount = await api.graph.getNode(api.tools.A.info.business, "children", { type: "squareaccount" });
        business = api.tools.A.info.business;
      }

      const customer = await api.graph.getNode(api.tools.A.info.user, "siblings", { type: "customer" }) || null;

      if (!squareaccount) {
          console.log("No Square account found for business.");
          return;
      }

      let name;
      let description;
      let title;
      let pricing;
      if (data?.options?.payment?.type === 'custom') {
        name = data.options.payment?.name || null;
        description = data.options.payment?.description || null;
        title = data.options.payment?.title || null;
        pricing = data.options.payment.pricing;
      } else if (data?.options?.payment?.type === 'object') {
        let object = await api.graph.get(data.options.payment.object.id, data.options.payment.object.type);
        if (object && object?.info) {
          name = object.info?.name || null;
          description = object.info?.description || null;
          title = object.info?.name || null;
          let pricingPath = `${object.info.type}_settings.pricing`;
          pricing = api.graph.getByPath(object.info, pricingPath);
        } else {
          name = null;
          description = null;
          title = null;
          pricing = {};
        }
      }

      billingPane.innerHTML = "";

      let checkoutOptions = {
          id: `payment-link.checkout`,
          content: {
              name,
              description,
              title,
              pricing
          },
          property: {
              default: null,
              element: {
                  element: 'checkout',
                  settings: {
                      titleSettings: {
                          show: false
                      },
                      contentSettings: {
                          element: "div"
                      },
                      pricingSettings: {},
                      financeSettings: {
                          provider: "square",
                          provideraccount: squareaccount,
                          customer: (customer?.info) ? customer : null
                      },
                      checkoutSettings: {
                          business,
                          header: true,
                          alert: false,
                          custom_fields: null,
                          customer: (customer?.info) ? false : true,
                          paymentmethod: true,
                          payment: true,
                          callback: null,
                          data: {}
                      }
                  }
              },
          },
          inherited: {}
      }
      let checkoutElement = await api.elements.runeraven.createElement(checkoutOptions);
      billingPane.appendChild(checkoutElement);
      api.tools.LM.load(false, billingPane);
    }

    await setupBilling();
</script>
