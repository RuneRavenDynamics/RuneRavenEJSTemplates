




<% 
    let currentPage = pagination?.currentPage || (pagination.offset || pagination.skip || parseInt(pagination.cursor) || 1) / (pagination.limit || pagination.take || 1);
 %>



<nav aria-label="Page navigation example">
  <ul class="pagination">
    <li class="page-item <%= (currentPage <= 1) ? 'disabled' : '' %>">
      <a class="page-link" href="?offset=<%= (currentPage - 2) * (pagination.limit || pagination.take || 1) %>&limit=<%= pagination.limit || pagination.take || 1 %>" aria-label="Previous">
        <span aria-hidden="true">&laquo;</span>
      </a>
    </li>
    <% for (let i = 1; i <= pagination.totalPages; i++) { %>
      <li class="page-item <%= (i === currentPage) ? 'active' : '' %>">
        <a class="page-link" href="?offset=<%= (i - 1) * (pagination.limit || pagination.take || 1) %>&limit=<%= pagination.limit || pagination.take || 1 %>"><%= i %></a>
      </li>
    <% } %>
    <li class="page-item <%= (pagination.hasMore) ? '' : 'disabled' %>">
      <a class="page-link" href="?offset=<%= currentPage * (pagination.limit || pagination.take || 1) %>&limit=<%= pagination.limit || pagination.take || 1 %>" aria-label="Next">
        <span aria-hidden="true">&raquo;</span>
      </a>
    </li>
  </ul>
</nav>